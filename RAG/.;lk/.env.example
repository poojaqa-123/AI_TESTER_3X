# --- LLM provider: set ONE of these (OpenRouter takes priority if both set) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
# GEN_MODEL=openai/gpt-oss-120b       # override the default per-provider model
# REWRITE_MODEL=llama-3.1-8b-instant

# --- Vector store ---------------------------------------------------------
# Standalone Qdrant service (the `qdrant` container in docker-compose.yml).
# Use http://qdrant:6333 when running via docker-compose, http://localhost:6333
# when running the app directly on the host against a locally-started Qdrant.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=qabuddy_kb

# --- App -------------------------------------------------------------------
# 5060/5061 are on Chrome's (and other browsers') hardcoded unsafe-ports list
# (reserved for SIP) — don't put this back on 5060.
PORT=8060

# --- Chunking overrides (chars; defaults are usually fine) -----------------
# CHUNK_SIZE_CODE=1800
# CHUNK_OVERLAP_CODE=250
# CHUNK_SIZE_TEST_CASE=1000
# CHUNK_OVERLAP_TEST_CASE=150
# CHUNK_SIZE_DOC=900
# CHUNK_OVERLAP_DOC=150
# CHUNK_SIZE_TRANSCRIPT=800
# CHUNK_OVERLAP_TRANSCRIPT=150
# CHUNK_SIZE_CHART=900
# CHUNK_OVERLAP_CHART=150
# CHUNK_SIZE_LOG=1500

# --- Retrieval tunables ------------------------------------------------
# TOP_N_HYBRID=20
# TOP_K_RERANK=4
# RRF_K=60
# REWRITE_ENABLED=true
